# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (contains your API Key!)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ/Android Studio
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
# Hide these generated KMP/Android files specifically
.idea/modules.xml
.idea/modules/
.idea/navEditor.xml

# Keystore files
*.jks
*.keystore
*.pem
*.p12
*.key

# External native build folder
.cxx/
.externalNativeBuild/

# Google Services (e.g. APIs or Firebase)
google-services.json

# Freeline
freeline_project_description.json
freeline_project_description.xml

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# Bundletool
*.apks

# MacOS
.DS_Store

